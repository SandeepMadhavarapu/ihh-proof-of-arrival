# Profile Factory secrets and build-time caches
.env
.env.*
!.env.example
OPENAI_API_KEY
*.key
*.pem
.profile-factory-cache/
pipeline-cache/
**/.profile-factory-cache/

# Local test/browser output
node_modules/
qa-out/
.DS_Store
__pycache__/
*.pyc

# Per-run evidence is uploaded by CI; never commit a stale successful run.
profiles/*/build-qa-report.json
profiles/*/handoff-log.jsonl
profiles/*/profile-state.json
profiles/*/source-index.json
profiles/*/verification-report.json
profiles/*/research-draft.REJECTED.md

# Full-resolution originals and whole-file page dumps stay local; every one can be re-downloaded
# from the download_url / stable_item_url columns of the inductee's media-manifest.csv.
inductees/*/media/*
!inductees/*/media/web/
inductees/*/sources/nara-*/
handover/*.zip

# Local Python environments; retain source, tests, and reviewed generated artifacts.
.venv/
venv/
.pytest_cache/
Thumbs.db
